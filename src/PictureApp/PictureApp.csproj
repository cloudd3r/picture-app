<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>PictureApp</RootNamespace>
    <AssemblyName>PictureApp</AssemblyName>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Product>PictureApp</Product>
    <Description>Lightweight image viewer for Windows 10 LTSC</Description>
    <Company>cloudd3r</Company>
    <Copyright>Copyright © 2026 cloudd3r</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\app.ico" />
  </ItemGroup>

</Project>
